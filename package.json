{
  "name": "katip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#modules/*": "./src/modules/*/index.ts",
    "#platform/*": "./src/platform/*/index.ts",
    "#protocol": "./src/protocol/index.ts"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.1",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@phosphor-icons/core": "2.1.1",
    "effect": "4.1.0",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

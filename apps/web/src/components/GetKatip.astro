---
import { CHROME_WEB_STORE_URL, GITHUB_LATEST_RELEASE_URL } from "../site.ts"

interface Props {
  /** Regular leads a section; small sits in the header. */
  readonly size: "regular" | "small"
}

const { size } = Astro.props
const inStore = CHROME_WEB_STORE_URL !== null
const href = CHROME_WEB_STORE_URL ?? GITHUB_LATEST_RELEASE_URL
const label = {
  regular: inStore ? "Add Katip to your browser" : "Download Katip",
  small: inStore ? "Install" : "Download",
}[size]
---

<a class:list={["get-katip", size]} href={href}>
  {label}
</a>

<style>
  .get-katip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.625rem;
    background: var(--button);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 1px 2px rgb(17 24 39 / 0.2);
    color: #fff;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background-color 150ms var(--ease),
      transform 150ms var(--ease);
  }

  .get-katip:hover {
    background: var(--button-hover);
    text-decoration: none;
  }

  .get-katip:active {
    transform: scale(0.98);
  }

  .regular {
    height: 3rem;
    padding-inline: 1.25rem;
    font-size: 1rem;
  }

  .small {
    height: 2.25rem;
    padding-inline: 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
  }
</style>

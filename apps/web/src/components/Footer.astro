---
import icon from "@brand/icon.svg"
import { PATHS, PRIVACY_PATHS } from "../routes.ts"
import { CHROME_WEB_STORE_URL, GITHUB_RELEASES_URL, GITHUB_URL, LICENSE_URL } from "../site.ts"

const columns = [
  {
    title: "Product",
    links: [
      { href: PATHS.features, label: "Features" },
      { href: PATHS.whatsNew, label: "What’s New" },
      { href: PATHS.arc, label: "Moving from Arc browser" },
      ...(CHROME_WEB_STORE_URL === null
        ? []
        : [{ href: CHROME_WEB_STORE_URL, label: "Chrome Web Store" }]),
      // Still offered beside the store, for a browser that can't install from it
      { href: GITHUB_RELEASES_URL, label: "Releases" },
    ],
  },
  {
    title: "Privacy",
    links: [
      { href: PRIVACY_PATHS.en, label: "Privacy policy" },
      { href: PRIVACY_PATHS.ja, label: "プライバシーポリシー", lang: "ja" },
    ],
  },
  {
    title: "Source",
    links: [
      { href: GITHUB_URL, label: "GitHub" },
      { href: `${GITHUB_URL}/issues`, label: "Report an issue" },
      { href: LICENSE_URL, label: "MIT License" },
    ],
  },
]
---

<footer class="site-footer">
  <div class="container">
    <div class="columns">
      <div class="brand">
        <a href={PATHS.home}>
          <img src={icon.src} width="28" height="28" alt="" loading="lazy" />
          Katip
        </a>
        <p>Vertical tabs and Spaces in your browser’s side panel</p>
      </div>
      {columns.map(({ title, links }) => (
        <nav aria-label={title}>
          <h2>{title}</h2>
          <ul>
            {links.map((link) => (
              <li>
                <a href={link.href} lang={"lang" in link ? link.lang : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <p class="fine-print">© 2026 qaynam</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-space);
    padding-block: 3rem 2.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }

  .brand a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
  }

  .brand a:hover {
    text-decoration: none;
  }

  .brand p {
    max-width: 16rem;
    margin-top: 0.75rem;
    color: var(--ink-faint);
  }

  h2 {
    color: var(--ink);
    font-size: 0.875rem;
  }

  ul {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  ul a {
    color: var(--ink-soft);
  }

  ul a:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .fine-print {
    margin-top: 3rem;
    color: var(--ink-faint);
    font-size: 0.8125rem;
  }

  @media (max-width: 48rem) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .brand {
      grid-column: 1 / -1;
    }
  }
</style>

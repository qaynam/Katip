---
import type { SvgComponent } from "astro/types"

export interface ShowcaseItem {
  readonly title: string
  /** What the item says when open, as HTML: the site's own copy, never anything a visitor typed. */
  readonly html: string
  /** Which of the `media-<n>` slots shows while the item is open. */
  readonly media: number
}

interface Props {
  /** The section's id, which its title and its items' panels take theirs from. */
  readonly id: string
  readonly Icon: SvgComponent
  /** Names the section above its title. */
  readonly label: string
  readonly title: string
  readonly lead: string
  readonly items: ReadonlyArray<ShowcaseItem>
  /**
   * Stretches the picture to the height of the words beside it, for a picture with no shape of
   * its own, such as a drawing on a backdrop.
   */
  readonly fill?: boolean
}

const { id, Icon, label, title, lead, items, fill = false } = Astro.props
const mediaCount = Math.max(...items.map((item) => item.media)) + 1
const mediaSlots = Array.from({ length: mediaCount }, (_, index) => `media-${index}`)
---

<section {id} class:list={["showcase", { fill }]} aria-labelledby={`${id}-title`} data-showcase>
  <div class="text">
    <p class="eyebrow">
      <Icon width={18} height={18} aria-hidden="true" />
      {label}
    </p>
    <h2 id={`${id}-title`} class="section-title">
      {title}
    </h2>
    <p class="lead">{lead}</p>
    <ul class="items">
      {items.map((item, index) => (
        <li class:list={["item", { open: index === 0 }]} data-media={item.media}>
          <h3>
            <button
              type="button"
              aria-expanded={index === 0 ? "true" : "false"}
              aria-controls={`${id}-panel-${index}`}
            >
              {item.title}
            </button>
          </h3>
          <div id={`${id}-panel-${index}`} class="panel">
            <p set:html={item.html} />
          </div>
        </li>
      ))}
    </ul>
  </div>
  <div class="media">
    {mediaSlots.map((name, index) => (
      <div class:list={["frame", { shown: index === 0 }]} data-frame={index}>
        <slot name={name} />
      </div>
    ))}
  </div>
</section>

<script>
  // Without this every item stays open beside the first picture, which still reads
  for (const showcase of document.querySelectorAll<HTMLElement>("[data-showcase]")) {
    const items = [...showcase.querySelectorAll<HTMLElement>(".item")]
    const frames = [...showcase.querySelectorAll<HTMLElement>("[data-frame]")]
    const open = (chosen: HTMLElement) => {
      for (const item of items) {
        const isChosen = item === chosen
        item.classList.toggle("open", isChosen)
        item.querySelector("button")?.setAttribute("aria-expanded", String(isChosen))
        const panel = item.querySelector<HTMLElement>(".panel")
        if (panel !== null) panel.hidden = !isChosen
      }
      for (const frame of frames) {
        frame.classList.toggle("shown", frame.dataset.frame === chosen.dataset.media)
      }
    }
    for (const item of items) {
      item.querySelector("button")?.addEventListener("click", () => open(item))
    }
    const [first] = items
    if (first !== undefined) open(first)
  }
</script>

<style>
  .showcase {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: center;
  }

  @media (min-width: 64rem) {
    .showcase {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    }
  }

  .lead {
    margin-top: 1.25rem;
  }

  .items {
    display: grid;
    gap: 0.25rem;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  .item {
    position: relative;
    padding: 0.75rem 0 0.75rem 1.25rem;
  }

  .item::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    border-radius: 1px;
    background: var(--line-strong);
    transition: background-color 200ms var(--ease);
  }

  .item.open::before {
    background: var(--ink);
  }

  h3 {
    font-size: 1.0625rem;
  }

  button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-soft);
    font: inherit;
    font-weight: 600;
    text-align: start;
    cursor: pointer;
    transition: color 150ms var(--ease);
  }

  button:hover,
  .open button {
    color: var(--ink);
  }

  .panel p {
    margin-top: 0.375rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .panel :global(code) {
    padding: 0.0625rem 0.3125rem;
    border-radius: 0.25rem;
    background: var(--raised);
    color: var(--ink);
  }

  @media (min-width: 64rem) {
    .fill {
      align-items: stretch;
    }

    .fill .frame > :global(*) {
      height: 100%;
    }
  }

  /* The pictures share one place, and the open item's shows */
  .media {
    display: grid;
  }

  .frame {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transform: scale(0.985);
    transition:
      opacity 320ms var(--ease),
      transform 320ms var(--ease),
      visibility 0s 320ms;
  }

  .frame.shown {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 320ms var(--ease),
      transform 320ms var(--ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .frame,
    .frame.shown {
      transform: none;
      transition: none;
    }
  }
</style>

---
import type { Detail } from "../copy"
import RichText from "./RichText.astro"

interface Props {
  readonly details: ReadonlyArray<Detail>
}

const { details } = Astro.props
const count = details.length
---

<ul class="details">
  {details.map((detail) => (
    <li>
      <h3>{detail.title}</h3>
      <p>
        <RichText text={typeof detail.text === "string" ? [detail.text] : detail.text} />
      </p>
    </li>
  ))}
</ul>

<style define:vars={{ count }}>
  /* One row or one column, never a wrapped grid that leaves the last detail alone on its row. The
     column is as wide as the section's intro above it, and the row narrows with fewer details so
     they stay together under the middle of the section */
  .details {
    display: grid;
    gap: 2rem clamp(1.5rem, 4vw, 3.5rem);
    max-width: var(--text-width);
    margin-inline: auto;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 52rem) {
    .details {
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
      max-width: min(60rem, var(--count) * 22rem);
    }
  }

  li {
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }

  p {
    margin-top: 0.375rem;
    color: var(--ink-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  p :global(code) {
    padding: 0.1em 0.35em;
    white-space: nowrap;
    border-radius: 0.375rem;
    background: var(--code-background);
  }

  :lang(ja) p {
    line-height: 1.75;
  }
</style>

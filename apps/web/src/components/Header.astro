---
import icon from "@brand/icon.svg"
import List from "@phosphor-icons/core/assets/regular/list.svg"
import { PATHS } from "../routes.ts"
import { GITHUB_URL } from "../site.ts"
import GetKatip from "./GetKatip.astro"

interface Props {
  /** The path of the page it heads, so its own link can say so. */
  readonly current: string
  /**
   * Keeps the header's download button out of sight while the page's first screen offers its own,
   * so the two never show together.
   */
  readonly downloadInHero?: boolean
}

const { current, downloadInHero = false } = Astro.props
const links = [
  { href: PATHS.features, label: "Features" },
  { href: PATHS.whatsNew, label: "What’s New" },
  { href: PATHS.privacy, label: "Privacy" },
  { href: GITHUB_URL, label: "GitHub" },
]
---

<header class="site-header">
  <div class="bar container">
    <a class="brand" href={PATHS.home}>
      <img src={icon.src} width="28" height="28" alt="" />
      Katip
    </a>
    <nav class="links" aria-label="Site">
      <ul>
        {links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={href === current ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class:list={["download", { "after-hero": downloadInHero }]}>
      <GetKatip size="small" />
    </div>
    <details class="menu">
      <summary aria-label="Menu">
        <List width={20} height={20} aria-hidden="true" />
      </summary>
      <nav aria-label="Site">
        <ul>
          {links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={href === current ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: var(--page);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-right: auto;
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .brand:hover {
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .links a,
  .menu nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    transition:
      color 150ms var(--ease),
      background-color 150ms var(--ease);
  }

  .links a:hover,
  .menu nav a:hover {
    background: var(--raised);
    color: var(--ink);
    text-decoration: none;
  }

  .links a[aria-current="page"],
  .menu nav a[aria-current="page"] {
    color: var(--ink);
  }

  .menu {
    display: none;
  }

  /* Hidden where the scroll can't reveal it: the first screen and the end of the page both offer
     the download already */
  .after-hero {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .after-hero {
      display: block;
      animation: reveal linear both;
    }

    /* A rule of its own: the minifier would otherwise fold the timeline into the animation
       shorthand above, which can't hold one, and the whole declaration would be dropped */
    .download.after-hero {
      animation-timeline: scroll(root);
      animation-range: 0 32rem;
    }
  }

  @keyframes reveal {
    0%,
    80% {
      visibility: hidden;
      opacity: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .bar {
      gap: 0.75rem;
    }

    .links {
      display: none;
    }

    .menu {
      position: relative;
      display: block;
    }

    summary {
      display: grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 0.5rem;
      color: var(--ink);
      list-style: none;
      cursor: pointer;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    .menu[open] summary {
      background: var(--raised);
    }

    .menu nav {
      position: absolute;
      top: calc(100% + 0.75rem);
      right: 0;
      width: 12rem;
      padding: 0.5rem;
      border-radius: 0.75rem;
      background: var(--surface);
      box-shadow:
        0 0 0 1px var(--line),
        0 8px 24px rgb(17 24 39 / 0.08);
    }

    .menu ul {
      flex-direction: column;
      gap: 0.125rem;
    }
  }
</style>

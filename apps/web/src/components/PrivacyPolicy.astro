---
import icon from "@brand/icon.svg"
import { getEntry, render } from "astro:content"
import { LANGUAGE_NAMES, LANGUAGES, type Language } from "../languages.ts"
import Page from "../layouts/Page.astro"
import { PRIVACY_PATHS } from "../routes.ts"

interface Props {
  readonly lang: Language
}

const { lang } = Astro.props
const policy = await getEntry("privacy", lang)
if (policy === undefined) throw new Error(`PRIVACY.md has no ${lang} policy`)
const { Content, headings } = await render(policy)
const sections = headings.filter((heading) => heading.depth === 2)
const translations = LANGUAGES.filter((language) => language !== lang)

const TEXT = {
  en: {
    title: "Privacy Policy",
    metaTitle: "Privacy Policy – Katip",
    description:
      "What data Katip handles and where it goes. In short: Katip has no server, collects nothing, and sends nothing to anyone.",
    contents: "On this page",
    readIn: "Read in",
  },
  ja: {
    title: "プライバシーポリシー",
    metaTitle: "プライバシーポリシー – Katip",
    description:
      "Katip が扱うデータと、その行き先。Katip はサーバーを持たず、データを集めず、誰にも何も送りません。",
    contents: "目次",
    readIn: "他の言語",
  },
} satisfies Record<Language, Record<string, string>>
const text = TEXT[lang]
---

<Page
  title={text.metaTitle}
  description={text.description}
  path={PRIVACY_PATHS[lang]}
  lang={lang}
  translations={PRIVACY_PATHS}
>
  <article class="policy container">
    <header class="head">
      <img src={icon.src} width="56" height="56" alt="" />
      <h1>{text.title}</h1>
      <p class="translations">
        <span class="visually-hidden">{text.readIn}: </span>
        {translations.map((language) => (
          <a href={PRIVACY_PATHS[language]} hreflang={language} lang={language}>
            {LANGUAGE_NAMES[language]}
          </a>
        ))}
      </p>
    </header>
    <div class="layout">
      <nav class="contents" aria-label={text.contents}>
        <ul>
          {sections.map((section) => (
            <li>
              <a href={`#${section.slug}`}>{section.text}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="body">
        <Content />
      </div>
    </div>
  </article>
</Page>

<style>
  .policy {
    padding-top: clamp(3rem, 1.5rem + 5vw, 6rem);
  }

  .head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    gap: 1.5rem 1.25rem;
  }

  .head img {
    grid-column: 1 / -1;
    width: 2.5rem;
  }

  h1 {
    font-size: clamp(2.5rem, 1.75rem + 3vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  :lang(ja) h1 {
    letter-spacing: 0;
    line-height: 1.25;
  }

  .translations {
    padding-bottom: 0.5rem;
  }

  .translations a {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .layout {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .contents ul {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .contents a {
    color: var(--ink-soft);
  }

  .contents a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 55.99rem) {
    .contents {
      display: none;
    }
  }

  @media (min-width: 56rem) {
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 18rem) minmax(0, 42rem);
      gap: clamp(3rem, 8vw, 8rem);
    }

    .contents {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }

  .body {
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.7;
  }

  .body :global(h2) {
    margin-top: 3rem;
    color: var(--ink);
    font-size: 1.5rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .body :global(h2:first-of-type) {
    margin-top: 2rem;
  }

  .body :global(p),
  .body :global(ul) {
    margin-top: 1rem;
  }

  .body :global(ul) {
    padding-left: 1.25rem;
  }

  .body :global(li + li) {
    margin-top: 0.5rem;
  }

  .body :global(li::marker) {
    color: var(--ink-faint);
  }

  .body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  /* The date line at the top */
  .body > :global(p:first-child) {
    margin-top: 0;
    color: var(--ink-faint);
    font-size: 0.9375rem;
  }

  .body > :global(p:first-child em) {
    font-style: normal;
  }

  .body :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 0.375rem;
    background: var(--raised);
  }
</style>

---
import { Picture } from "astro:assets"
import type { Language } from "../languages.ts"
import { screenshot } from "../screenshots.ts"
import type { Shot } from "../shots.ts"

interface Props {
  readonly lang: Language
  readonly shot: Shot
  readonly alt: string
  /** Which Space's colors glow behind the window, matching the side panel in the shot. */
  readonly glow: "work" | "personal" | "settings"
  /** For the shot in the first screen: loaded first and not faded in on scroll. */
  readonly priority?: boolean
}

const { lang, shot, alt, glow, priority = false } = Astro.props
const image = screenshot(lang, shot)
const MAX_WIDTH_REM = 80
const maxWidth = `${MAX_WIDTH_REM}rem`

// A whole window shrinks too far on a phone to read, so there the shot is cut down to this shape,
// keeping the part around its focus. The media query in the style below repeats the width, as a
// media query can't read a custom property
const NARROW_SCREEN_REM = 40
const NARROW_ASPECT_RATIO = 3 / 2
const NARROW_ZOOM = image.width / image.height / NARROW_ASPECT_RATIO

/** How far across each shot, from 0% at its left edge to 100% at its right, the part to keep lies. */
const FOCUS: Readonly<Record<Shot, number>> = {
  "1-spaces": 0,
  "2-spotlight": 50,
  "3-split-view": 0,
  "4-import": 100,
  "5-themes": 0,
  "6-bangs": 50,
}
const focus = `${FOCUS[shot]}%`
const narrowAspectRatio = String(NARROW_ASPECT_RATIO)
---

<div class:list={["screenshot", glow, { revealed: !priority }]}>
  <Picture
    src={image}
    alt={alt}
    widths={[544, 816, 1088, 1632, image.width]}
    sizes={[
      `(max-width: ${NARROW_SCREEN_REM}rem) calc((100vw - 2.5rem) * ${NARROW_ZOOM.toFixed(2)})`,
      `(min-width: ${MAX_WIDTH_REM + 5}rem) ${MAX_WIDTH_REM}rem`,
      "calc(100vw - 2.5rem)",
    ].join(", ")}
    formats={["avif", "webp"]}
    quality={82}
    priority={priority}
  />
</div>

<style define:vars={{ maxWidth, focus, narrowAspectRatio }}>
  /* Wider than the text around it, reaching past the page width into the gutters on a wide
     screen */
  .screenshot {
    --width: min(100vw - 2 * var(--gutter), var(--maxWidth));
    position: relative;
    isolation: isolate;
    width: var(--width);
    margin-inline: calc((100% - var(--width)) / 2);
  }

  .screenshot::before {
    content: "";
    position: absolute;
    inset: 6% -3% -9%;
    z-index: -1;
    background:
      radial-gradient(55% 65% at 22% 55%, var(--glow-a), transparent 72%),
      radial-gradient(55% 65% at 78% 60%, var(--glow-b), transparent 72%);
    filter: blur(56px);
    opacity: var(--glow-strength);
  }

  .work {
    --glow-a: #86b3f5;
    --glow-b: #b4a9f2;
  }

  .personal {
    --glow-a: #f7a184;
    --glow-b: #ee9cc2;
  }

  .settings {
    --glow-a: #aebbd2;
    --glow-b: #d9c6b0;
  }

  .screenshot :global(img) {
    width: 100%;
    /* The window's 14px corners, cut a hair wider so no backdrop pixel shows at the edge */
    border-radius: 1.4% / 2.65%;
    box-shadow: var(--window-shadow);
  }

  @media (max-width: 40rem) {
    .screenshot :global(img) {
      aspect-ratio: var(--narrowAspectRatio);
      object-fit: cover;
      object-position: var(--focus) 50%;
      border-radius: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .revealed {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 5% entry 45%;
      }
    }
  }

  @keyframes rise {
    from {
      opacity: 0.35;
      transform: translateY(2.5rem) scale(0.97);
    }
  }
</style>

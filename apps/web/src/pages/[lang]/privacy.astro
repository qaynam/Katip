---
import type { GetStaticPaths } from "astro"
import { getEntry, render } from "astro:content"
import { COPY } from "../../copy"
import { LANGUAGES, type Language } from "../../languages.ts"
import Page from "../../layouts/Page.astro"

export const getStaticPaths = (() =>
  LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }))) satisfies GetStaticPaths

interface Props {
  readonly lang: Language
}

const { lang } = Astro.props
const copy = COPY[lang]
const policy = await getEntry("privacy", lang)
if (policy === undefined) throw new Error(`PRIVACY.md has no ${lang} policy`)
const { Content } = await render(policy)
---

<Page
  lang={lang}
  page="privacy"
  title={copy.privacyPage.metaTitle}
  description={copy.privacyPage.description}
>
  <article class="policy container">
    <h1>{copy.privacyPage.title}</h1>
    <div class="body">
      <Content />
    </div>
  </article>
</Page>

<style>
  .policy {
    max-width: 44rem;
    padding-block: clamp(3.5rem, 2rem + 5vw, 6rem) var(--section-space);
  }

  h1 {
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  :lang(ja) h1 {
    line-height: 1.3;
    letter-spacing: 0;
  }

  .body {
    margin-top: 0.75rem;
  }

  .body :global(h2) {
    margin-top: 3rem;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.018em;
  }

  .body :global(p),
  .body :global(ul) {
    margin-top: 1rem;
  }

  .body :global(ul) {
    padding-left: 1.25rem;
  }

  .body :global(li + li) {
    margin-top: 0.5rem;
  }

  .body :global(li::marker) {
    color: var(--ink-secondary);
  }

  .body :global(strong) {
    font-weight: 600;
  }

  /* The date line under the title */
  .body > :global(p:first-child) {
    margin-top: 0;
    color: var(--ink-secondary);
    font-size: 0.9375rem;
  }

  .body > :global(p:first-child em) {
    font-style: normal;
  }

  .body :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 0.375rem;
    background: var(--code-background);
  }
</style>

---
import icon from "@brand/icon.svg"
import Broom from "@phosphor-icons/core/assets/regular/broom.svg"
import Check from "@phosphor-icons/core/assets/regular/check.svg"
import Command from "@phosphor-icons/core/assets/regular/command.svg"
import DownloadSimple from "@phosphor-icons/core/assets/regular/download-simple.svg"
import HandWaving from "@phosphor-icons/core/assets/regular/hand-waving.svg"
import LockKey from "@phosphor-icons/core/assets/regular/lock-key.svg"
import RssSimple from "@phosphor-icons/core/assets/regular/rss-simple.svg"
import Translate from "@phosphor-icons/core/assets/regular/translate.svg"
import type { GetStaticPaths } from "astro"
import type { SvgComponent } from "astro/types"
import Cta from "../../components/Cta.astro"
import Details from "../../components/Details.astro"
import RichText from "../../components/RichText.astro"
import Screenshot from "../../components/Screenshot.astro"
import SectionIntro from "../../components/SectionIntro.astro"
import { COPY, type MoreFeature } from "../../copy"
import { LANGUAGES, type Language } from "../../languages.ts"
import Page from "../../layouts/Page.astro"
import { pathOf } from "../../routes.ts"
import { CHROME_WEB_STORE_URL } from "../../site.ts"

export const getStaticPaths = (() =>
  LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }))) satisfies GetStaticPaths

interface Props {
  readonly lang: Language
}

const { lang } = Astro.props
const copy = COPY[lang]

const features = [
  {
    id: "spotlight",
    section: copy.spotlight,
    screenshot: { shot: "2-spotlight", alt: copy.spotlight.screenshotAlt, glow: "work" },
  },
  { id: "bangs", section: copy.bangs, screenshot: null },
  {
    id: "split-view",
    section: copy.splitView,
    screenshot: { shot: "3-split-view", alt: copy.splitView.screenshotAlt, glow: "work" },
  },
  {
    id: "themes",
    section: copy.themes,
    screenshot: { shot: "5-themes", alt: copy.themes.screenshotAlt, glow: "personal" },
  },
] as const

// Long paths wrap after a separator rather than in the middle of a folder name
const breakablePath = (path: string) => path.split(/(?<=[\\/])/)

const moreFeatures: ReadonlyArray<{ readonly key: MoreFeature; readonly Icon: SvgComponent }> = [
  { key: "liveFolders", Icon: RssSimple },
  { key: "temporaryTabs", Icon: Broom },
  { key: "shortcuts", Icon: Command },
  { key: "tour", Icon: HandWaving },
  { key: "data", Icon: DownloadSimple },
  { key: "languages", Icon: Translate },
]
---

<Page lang={lang} page="home" title={copy.meta.title} description={copy.meta.description}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero-text">
        <img class="app-icon" src={icon.src} width="128" height="128" alt="" />
        <h1 id="hero-title">{copy.hero.title}</h1>
        <p class="hero-lead">{copy.hero.lead}</p>
        <Cta lang={lang} />
        <p class="hero-note">{copy.hero.note}</p>
      </div>
      <div class="hero-shot">
        <Screenshot
          lang={lang}
          shot="1-spaces"
          alt={copy.hero.screenshotAlt}
          glow="work"
          priority
        />
      </div>
    </div>
  </section>

  <section id="features" class="section spaces container" aria-labelledby="spaces-title">
    <SectionIntro intro={copy.spaces} titleId="spaces-title" />
    <Details details={copy.spaces.details} />
  </section>

  {features.map(({ id, section, screenshot }) => (
    <section id={id} class="section container" aria-labelledby={`${id}-title`}>
      <SectionIntro intro={section} titleId={`${id}-title`} />
      {screenshot !== null && (
        <div class="shot">
          <Screenshot
            lang={lang}
            shot={screenshot.shot}
            alt={screenshot.alt}
            glow={screenshot.glow}
          />
        </div>
      )}
      <Details details={section.details} />
    </section>
  ))}

  <section id="more" class="section container" aria-labelledby="more-title">
    <SectionIntro intro={copy.more} titleId="more-title" />
    <ul class="more-list">
      {moreFeatures.map(({ key, Icon }) => (
        <li>
          <span class="chip" aria-hidden="true">
            <Icon width={22} height={22} />
          </span>
          <h3>{copy.more.features[key].title}</h3>
          <p>{copy.more.features[key].text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="arc" class="section container" aria-labelledby="arc-title">
    <SectionIntro intro={copy.arc} titleId="arc-title" />
    <div class="shot">
      <Screenshot lang={lang} shot="4-import" alt={copy.arc.screenshotAlt} glow="settings" />
    </div>
    <div class="arc-guide">
      <div class="steps">
        <h3>{copy.arc.stepsTitle}</h3>
        <ol>
          <li>
            <RichText text={copy.arc.steps.openSettings} />
          </li>
          <li>
            <RichText text={copy.arc.steps.chooseFile} />
          </li>
          <li>
            <RichText text={copy.arc.steps.import} />
          </li>
        </ol>
      </div>
      <div>
        <h3>{copy.arc.locationsTitle}</h3>
        <dl class="locations">
          {copy.arc.locations.map((location) => (
            <div>
              <dt>{location.system}</dt>
              <dd>
                <code>
                  {breakablePath(location.path).map((part) => (
                    <>
                      {part}
                      <wbr />
                    </>
                  ))}
                </code>
                <span>{location.hint}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <ul class="promises">
        {copy.arc.promises.map((promise) => (
          <li>
            <Check width={20} height={20} aria-hidden="true" />
            {promise}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="privacy" class="section container" aria-labelledby="privacy-title">
    <div class="privacy-card">
      <span class="privacy-mark" aria-hidden="true">
        <LockKey width={28} height={28} />
      </span>
      <SectionIntro intro={copy.privacy} titleId="privacy-title" />
      <Details details={copy.privacy.points} />
      <p class="policy-link">
        <a href={pathOf(lang, "privacy")}>
          {copy.privacy.policyLink}
          <span aria-hidden="true"> →</span>
        </a>
      </p>
    </div>
  </section>

  <section id="open-source" class="section closing container" aria-labelledby="open-source-title">
    <img class="app-icon small" src={icon.src} width="96" height="96" alt="" loading="lazy" />
    <SectionIntro intro={copy.openSource} titleId="open-source-title" />
    <div class="closing-cta">
      <Cta lang={lang} />
      {CHROME_WEB_STORE_URL === null && (
        <p class="release">
          <RichText text={copy.cta.fromRelease} />
        </p>
      )}
    </div>
  </section>
</Page>

<style>
  .hero {
    padding-top: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    background: radial-gradient(90% 55% at 50% 0%, var(--surface) 0%, var(--backdrop) 75%);
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .app-icon {
    width: clamp(6rem, 4.5rem + 4vw, 8rem);
    margin-bottom: 1.25rem;
  }

  .app-icon.small {
    width: 6rem;
    margin: 0 auto 0.75rem;
  }

  h1 {
    max-width: 15em;
    font-size: clamp(2.25rem, 1.2rem + 4.8vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.034em;
  }

  .hero-lead {
    max-width: 36rem;
    margin-top: 1.5rem;
    color: var(--ink-secondary);
    font-size: clamp(1.1875rem, 1.05rem + 0.6vw, 1.4375rem);
    line-height: 1.45;
    letter-spacing: -0.016em;
  }

  .hero-text :global(.cta) {
    margin-top: 2.25rem;
  }

  .hero-note {
    margin-top: 1rem;
    color: var(--ink-secondary);
    font-size: 0.875rem;
  }

  :lang(ja) h1 {
    max-width: 13em;
    font-size: clamp(2.125rem, 1.2rem + 3.6vw, 3.75rem);
    line-height: 1.2;
    letter-spacing: 0;
  }

  :lang(ja) .hero-lead {
    max-width: 38rem;
    line-height: 1.75;
    letter-spacing: 0;
  }

  .hero-shot {
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .section {
    padding-top: var(--section-space);
  }

  /* Closer to the hero than the other sections are to each other: the hero's screenshot is this
     section's picture */
  .spaces {
    padding-top: calc(var(--section-space) * 0.7);
  }

  .section > :global(.details),
  .privacy-card > :global(.details) {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .shot,
  .more-list {
    margin-top: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  /* And more */

  .more-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
    padding: 0;
  }

  .more-list li {
    padding: 1.5rem;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--card-shadow);
    list-style: none;
  }

  .chip {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .more-list h3 {
    margin-top: 1.125rem;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .more-list p {
    margin-top: 0.375rem;
    color: var(--ink-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  :lang(ja) .more-list p {
    line-height: 1.7;
    letter-spacing: 0;
  }

  /* Coming from Arc */

  .arc-guide {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2rem clamp(2rem, 5vw, 4rem);
    max-width: 60rem;
    margin: clamp(2.5rem, 2rem + 2vw, 3.5rem) auto 0;
  }

  .arc-guide h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .steps ol {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding-left: 2.75rem;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .steps strong {
    font-weight: 600;
  }

  .locations {
    display: grid;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
  }

  .locations div {
    padding: 0.75rem 1rem;
    border-radius: 0.875rem;
    background: var(--surface);
    box-shadow: var(--card-shadow);
  }

  .locations dt {
    color: var(--ink-secondary);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .locations dd {
    margin: 0.125rem 0 0;
  }

  .locations code {
    display: block;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .locations span {
    display: block;
    margin-top: 0.25rem;
    color: var(--ink-secondary);
    font-size: 0.8125rem;
  }

  .promises {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem clamp(1.5rem, 4vw, 3.5rem);
    padding: 1.5rem;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--card-shadow);
    list-style: none;
  }

  .promises li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    font-size: 0.9375rem;
  }

  .promises :global(svg) {
    margin-top: 0.125rem;
    color: var(--accent);
  }

  :lang(ja) :is(.steps li, .promises li) {
    word-break: auto-phrase;
  }

  /* Privacy */

  .privacy-card {
    padding: clamp(3rem, 2rem + 4vw, 5rem) clamp(1.5rem, 0.5rem + 5vw, 5rem);
    border-radius: 2rem;
    background: var(--surface);
    box-shadow: var(--card-shadow);
  }

  .privacy-mark {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto 1.5rem;
    border-radius: 1rem;
    background: linear-gradient(#68c6ff, #1f74f0);
    box-shadow: var(--icon-shadow);
    color: #fff;
  }

  .policy-link {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    text-align: center;
    font-weight: 500;
  }

  /* Open source */

  .closing {
    padding-bottom: calc(var(--section-space) * 0.75);
    text-align: center;
  }

  .closing-cta {
    margin-top: 2.25rem;
  }

  .release {
    max-width: 32rem;
    margin: 1.25rem auto 0;
    color: var(--ink-secondary);
    font-size: 0.875rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-text > *,
    .hero-shot {
      animation: arrive 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .hero-text > :nth-child(2) {
      animation-delay: 60ms;
    }

    .hero-text > :nth-child(3) {
      animation-delay: 120ms;
    }

    .hero-text > :nth-child(n + 4) {
      animation-delay: 180ms;
    }

    .hero-shot {
      animation-duration: 1.1s;
      animation-delay: 260ms;
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
</style>

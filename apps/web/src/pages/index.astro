---
import ArrowRight from "@phosphor-icons/core/assets/regular/arrow-right.svg"
import ArrowSquareIn from "@phosphor-icons/core/assets/regular/arrow-square-in.svg"
import Broom from "@phosphor-icons/core/assets/regular/broom.svg"
import Code from "@phosphor-icons/core/assets/regular/code.svg"
import Columns from "@phosphor-icons/core/assets/regular/columns.svg"
import Command from "@phosphor-icons/core/assets/regular/command.svg"
import DownloadSimple from "@phosphor-icons/core/assets/regular/download-simple.svg"
import Keyboard from "@phosphor-icons/core/assets/regular/keyboard.svg"
import LockSimple from "@phosphor-icons/core/assets/regular/lock-simple.svg"
import Palette from "@phosphor-icons/core/assets/regular/palette.svg"
import RssSimple from "@phosphor-icons/core/assets/regular/rss-simple.svg"
import SquaresFour from "@phosphor-icons/core/assets/regular/squares-four.svg"
import Translate from "@phosphor-icons/core/assets/regular/translate.svg"
import type { SvgComponent } from "astro/types"
import Actions from "../components/Actions.astro"
import Mat from "../components/Mat.astro"
import LiveFoldersMock from "../components/mocks/LiveFoldersMock.astro"
import Recording from "../components/Recording.astro"
import Shot from "../components/Shot.astro"
import Showcase from "../components/Showcase.astro"
import Page from "../layouts/Page.astro"
import { PATHS } from "../routes.ts"

const HERO_SIZES = "(min-width: 76rem) 68rem, calc(100vw - 6rem)"
const SHOWCASE_SIZES = "(min-width: 86rem) 48rem, (min-width: 64rem) 56vw, calc(100vw - 4rem)"

const heroFacts = [
  {
    title: "Pins that sync",
    text: "Pinned tabs and folders are saved as bookmarks, so your browser’s sync carries them.",
  },
  {
    title: "Favorites for each Space",
    text: "Each Space keeps its own most-used pages as icons at the top.",
  },
  {
    title: "Swipe between Spaces",
    text: "Swipe across the sidebar to the next Space, or past the last one to start a new one.",
  },
]

const more: ReadonlyArray<{
  readonly Icon: SvgComponent
  readonly title: string
  readonly text: string
}> = [
  {
    Icon: DownloadSimple,
    title: "Downloads",
    text: "Your downloads in the sidebar. Search them, narrow them to a kind of file, and open, pause or resume one.",
  },
  {
    Icon: Broom,
    title: "Temporary tabs",
    text: "Clear the tabs you didn’t pin in one click, or let idle ones move to the Archive.",
  },
  {
    Icon: Keyboard,
    title: "Keyboard shortcuts",
    text: "Open the sidebar or the Command Palette, or copy a link as text or Markdown.",
  },
  {
    Icon: Translate,
    title: "Four languages",
    text: "English, Japanese, Simplified Chinese and Spanish.",
  },
]

const privacyLedger = [
  { name: "Account", value: "None to create" },
  { name: "Server", value: "None" },
  { name: "Analytics and telemetry", value: "None" },
  { name: "Ads", value: "None" },
  { name: "Your pins", value: "Saved as your own bookmarks" },
  {
    name: "Live folders",
    value: "Only those you add, straight from your browser to Gmail or GitHub",
  },
  { name: "Update check", value: "In the GitHub build only, and you can turn it off" },
]

const ARC_FILE_HINT =
  "On a Mac it is <code>~/Library/Application Support/Arc/StorableSidebar.json</code>; press ⌘⇧G in the file dialog to paste the path. On Windows it is in Arc’s folder under <code>%LOCALAPPDATA%\\Packages</code>."
---

<Page
  title="Katip – Not another browser"
  description="Katip is a private, open-source extension that gives the Chromium browser you already use Spaces, vertical tabs, pinned folders, split view and a Command Palette. Nothing leaves your browser."
  path={PATHS.home}
  downloadInHero
>
  <section class="hero container" aria-labelledby="hero-title">
    <h1 id="hero-title">Not another browser</h1>
    <div class="hero-side">
      <p class="lead">
        Katip is a private, open-source extension that gives the Chromium browser you already use
        Spaces, vertical tabs and a Command Palette. No account, no server, and nothing leaves your
        browser.
      </p>
      <Actions />
    </div>
  </section>

  <div class="hero-view container">
    <Shot
      shot="1-spaces"
      clip="hero"
      tone="apricot"
      alt="Katip in the browser’s side panel next to a document. The Work Space shows a row of Favorites, a Product folder holding pinned tabs and a pinned split view, more folders, a live folder of important mail, and the open tabs below them."
      sizes={HERO_SIZES}
      priority
    />
    <ul class="facts">
      {heroFacts.map(({ title, text }) => (
        <li>
          <h2>{title}</h2>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </div>

  <div id="features">
    <div class="band mint">
      <div class="wide">
        <Showcase
          id="palette"
          Icon={Command}
          label="Command Palette"
          title="Find anything, run any command"
          lead="One box for your tabs, pins, Favorites, bookmarks and the web, and your history if you allow it."
          items={[
            {
              title: "Search everything",
              html: "Type a few letters of a tab or a pin, or a command such as Copy URL or Toggle Sidebar, and press Enter.",
              media: 0,
            },
            {
              title: "Bangs",
              html: "<code>!gh katip</code> searches GitHub and <code>!w</code> Wikipedia, and any site can have a keyword of its own.",
              media: 1,
            },
            {
              title: "One key away",
              html: "<kbd>⌥</kbd> <kbd>T</kbd> on a Mac, <kbd>Alt</kbd> <kbd>T</kbd> elsewhere, or any key you set in your browser.",
              media: 2,
            },
          ]}
        >
          <Shot
            slot="media-0"
            shot="2-spotlight"
            clip="command-palette"
            tone="mint"
            alt="The Command Palette open over the browser window with “copy” typed. The results are the commands Copy URL and Copy URL as Markdown Link, an open tab whose title matches, and a web search."
            sizes={SHOWCASE_SIZES}
          />
          <Shot
            slot="media-1"
            shot="6-bangs"
            clip="bangs"
            tone="mint"
            alt="The Command Palette with “!” typed, listing site searches with their shortcuts."
            sizes={SHOWCASE_SIZES}
          />
          <div slot="media-2" class="sequence keys-then-palette">
            <Shot
              shot="1-spaces"
              clip="shortcut"
              tone="mint"
              alt="The keys ⌥ T pressed over the browser window, and the Command Palette opening."
              sizes={SHOWCASE_SIZES}
            />
            <p class="keycaps" aria-hidden="true">
              <kbd>⌥</kbd>
              <kbd>T</kbd>
            </p>
            <div class="later" aria-hidden="true">
              <Shot shot="2-spotlight" clip="shortcut" tone="mint" alt="" sizes={SHOWCASE_SIZES} />
            </div>
          </div>
        </Showcase>
      </div>
    </div>
    <div class="band sand">
      <div class="wide">
        <Showcase
          id="split"
          Icon={Columns}
          label="Split view"
          title="Two pages side by side, saved as one pin"
          lead="Read a spec beside its prototype, or notes beside a call, and come back to the pair later."
          items={[
            {
              title: "Drop a tab on a tab",
              html: "Drag one tab onto another, or onto either side of the page, to open both in the browser’s split view.",
              media: 0,
            },
            {
              title: "One pin for the pair",
              html: "Pin the split view and it stays in its folder as one row, opening both pages together.",
              media: 1,
            },
          ]}
        >
          <Shot
            slot="media-0"
            shot="3-split-view"
            clip="split-view"
            tone="lemon"
            alt="A UI spec and a prototype side by side in a split view, the pair shown as one row among the sidebar’s temporary tabs."
            sizes={SHOWCASE_SIZES}
          />
          <Shot
            slot="media-1"
            shot="3-split-pinned"
            clip="split-pin"
            tone="lemon"
            alt="The same split view pinned, as one row in the sidebar’s Product folder."
            sizes={SHOWCASE_SIZES}
          />
        </Showcase>
      </div>
    </div>
    <div class="band lilac">
      <div class="wide">
        <Showcase
          id="themes"
          Icon={Palette}
          label="Themes"
          title="Colors for every Space"
          lead="Each Space gets a look of its own, so you know which one you’re in at a glance."
          items={[
            {
              title: "A color for each Space",
              html: "Work in blue, the weekend in coral: switching Spaces switches the colors along with the tabs.",
              media: 0,
            },
            {
              title: "Gradients and textures",
              html: "Start from a preset or mix your own colors, then add grain, film, linen or paper.",
              media: 1,
            },
          ]}
        >
          <div slot="media-0" class="sequence space-switch">
            <Shot
              shot="1-spaces"
              clip="space-colors"
              tone="apricot"
              alt="Switching between the Work Space, tinted blue, and the Personal Space, tinted coral."
              sizes={SHOWCASE_SIZES}
            />
            <div class="later" aria-hidden="true">
              <Shot
                shot="7-personal"
                clip="space-colors"
                tone="sky"
                alt=""
                sizes={SHOWCASE_SIZES}
              />
            </div>
          </div>
          <Shot
            slot="media-1"
            shot="5-themes"
            clip="themes"
            tone="sky"
            alt="The theme editor in the sidebar of a Personal Space tinted coral and pink, with a color field, preset colors and a light, dark or auto switch."
            sizes={SHOWCASE_SIZES}
          />
        </Showcase>
      </div>
    </div>
    <div class="band sky">
      <div class="wide">
        <Showcase
          id="live"
          fill
          Icon={RssSimple}
          label="Live folders"
          title="Gmail and GitHub, as folders that fill themselves"
          lead="Mail and notifications you’ve read leave the list, and an item opens right where it sits."
          items={[
            {
              title: "Important mail",
              html: "Follow the mail Gmail marks important, your Primary inbox or a label, each sender shown by their site’s icon.",
              media: 0,
            },
            {
              title: "Reviews and notifications",
              html: "Review requests, pull requests or your GitHub notifications, read with the session you’re already signed in with. No token to paste.",
              media: 0,
            },
            {
              title: "A notification when it matters",
              html: "A system notification for new important mail or GitHub items, if you turn it on.",
              media: 0,
            },
          ]}
        >
          <Mat slot="media-0" tone="rose">
            <Recording
              clip="live-folders"
              alt="Two live folders in the sidebar: important mail, and GitHub review requests."
            >
              <LiveFoldersMock />
            </Recording>
          </Mat>
        </Showcase>
      </div>
    </div>
  </div>

  <div id="arc" class="section wide">
    <Showcase
      id="arc-import"
      Icon={ArrowSquareIn}
      label="Moving from Arc browser"
      title="Move over in a minute"
      lead="Bring your Spaces with their colors, pins, folders, split views and Favorites. Katip only adds, and the file never leaves your browser."
      items={[
        {
          title: "1. Open the import",
          html: "In Katip’s settings, choose <strong>Data → Import from Arc</strong>.",
          media: 0,
        },
        {
          title: "2. Choose Arc’s sidebar file",
          html: `Pick <code>StorableSidebar.json</code>. ${ARC_FILE_HINT}`,
          media: 0,
        },
        {
          title: "3. Check, then import",
          html: "The preview lists what will be added, and whether each Arc Space stays a Space or becomes a folder.",
          media: 0,
        },
      ]}
    >
      <Shot
        slot="media-0"
        shot="4-import"
        clip="arc-import"
        tone="sky"
        alt="Katip’s settings on the Data page, previewing an import from Arc: the Spaces to import from each Arc profile, whether to keep them separate or combine them, and what will be added."
        sizes={SHOWCASE_SIZES}
      />
    </Showcase>
  </div>

  <section class="section container" aria-labelledby="more-title">
    <p class="eyebrow">
      <SquaresFour width={18} height={18} aria-hidden="true" />
      And more
    </p>
    <h2 id="more-title" class="section-title">
      Also in the sidebar
    </h2>
    <ul class="more">
      {more.map(({ Icon, title, text }) => (
        <li>
          <Icon width={20} height={20} aria-hidden="true" />
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="privacy" class="band dark" aria-labelledby="privacy-title">
    <div class="privacy container">
      <div>
        <p class="eyebrow">
          <LockSimple width={18} height={18} aria-hidden="true" />
          Privacy
        </p>
        <h2 id="privacy-title" class="section-title">
          Nothing leaves your browser
        </h2>
        <p class="lead">
          Katip has no server and collects nothing. What it keeps stays in your browser, and what it
          fetches, it fetches from your browser.
        </p>
        <a class="text-link" href={PATHS.privacy}>
          Read the privacy policy
          <ArrowRight width={16} height={16} aria-hidden="true" />
        </a>
      </div>
      <dl class="ledger">
        {privacyLedger.map(({ name, value }) => (
          <div>
            <dt>{name}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section container" aria-labelledby="open-source-title">
    <div class="closing">
      <div>
        <p class="eyebrow">
          <Code width={18} height={18} aria-hidden="true" />
          Open source
        </p>
        <h2 id="open-source-title" class="section-title">
          Every line of it is on GitHub
        </h2>
        <p class="lead">
          Katip is free under the MIT License. The name and logo aren’t, so please give your version
          its own.
        </p>
      </div>
      <Actions note={false} />
    </div>
  </section>
</Page>

<style>
  /* Hero */

  .hero {
    padding-top: clamp(4rem, 2rem + 6vw, 8rem);
    text-align: center;
  }

  h1 {
    font-size: clamp(3rem, 1.75rem + 5vw, 6rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .hero-side {
    display: grid;
    justify-items: center;
    gap: 2rem;
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  .hero-side .lead {
    max-width: 36rem;
  }

  .hero-side :global(.buttons) {
    justify-content: center;
  }

  .hero-view {
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .facts {
    display: grid;
    gap: 1.5rem 2rem;
    margin-top: 3rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .facts li,
  .more li {
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .facts h2,
  .more h3 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .facts p,
  .more p {
    margin-top: 0.25rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: no-preference) {
    h1,
    .hero-side,
    .hero-view {
      animation: arrive 400ms var(--ease) both;
    }

    .hero-side {
      animation-delay: 50ms;
    }

    .hero-view {
      animation-delay: 100ms;
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  /* The showcases take more of the screen than the text sections, so the pictures can be big */

  .wide {
    width: min(100% - 2 * var(--gutter), 84rem);
    margin-inline: auto;
  }

  /* Pictures that play out a moment, the later picture fading in over the first, and starting
     over each time their item opens */
  .sequence {
    position: relative;
  }

  .later {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .keycaps {
    position: absolute;
    bottom: 14%;
    left: 50%;
    display: flex;
    gap: 0.75rem;
    opacity: 0;
    translate: -50% 0;
  }

  .keycaps kbd {
    min-width: 4.5rem;
    height: 4.5rem;
    border-radius: 1rem;
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 4px 0 rgb(17 24 39 / 0.12),
      0 18px 36px -12px rgb(17 24 39 / 0.3);
    font-size: 2rem;
  }

  /* Without motion, the moment shows as it ends */
  @media (prefers-reduced-motion: reduce) {
    .later {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.frame.shown) .keys-then-palette .keycaps {
      animation: keys-appear 5s var(--ease) infinite;
    }

    :global(.frame.shown) .keys-then-palette .keycaps kbd {
      animation: key-press 5s var(--ease) infinite;
    }

    :global(.frame.shown) .keys-then-palette .later {
      animation: palette-opens 5s var(--ease) infinite;
    }

    :global(.frame.shown) .space-switch .later {
      animation: space-switches 6s var(--ease) infinite;
    }
  }

  @keyframes keys-appear {
    0% {
      opacity: 0;
      transform: translateY(0.75rem);
    }

    10%,
    24% {
      opacity: 1;
      transform: none;
    }

    30%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes key-press {
    0%,
    14% {
      transform: none;
    }

    17% {
      transform: translateY(0.25rem);
    }

    22%,
    100% {
      transform: none;
    }
  }

  @keyframes palette-opens {
    0%,
    22% {
      opacity: 0;
    }

    30%,
    88% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  @keyframes space-switches {
    0%,
    38% {
      opacity: 0;
    }

    50%,
    88% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  /* Bands of their own color, so each part of the page reads as its own */

  .band {
    margin-top: var(--section-space);
    padding-block: var(--section-space);
  }

  /* Each feature on a color of its own, so they read as separate things. Bands that follow one
     another touch, the change of color marking where one ends */
  .band + .band {
    margin-top: 0;
  }

  .band.mint {
    background: #eef7f0;
  }

  .band.sand {
    background: #f9f4ea;
  }

  .band.lilac {
    background: #f3f1fb;
  }

  .band.sky {
    background: #edf3fb;
  }

  .band.dark {
    --ink: #eef1f7;
    --ink-soft: #a9b2c4;
    --ink-faint: #8a93a6;
    --line: rgb(255 255 255 / 0.1);
    --line-strong: rgb(255 255 255 / 0.18);
    --surface: rgb(255 255 255 / 0.08);
    --shadow-small: none;
    background: var(--band-dark);
    color: var(--ink);
  }

  .band.dark .text-link {
    color: #9dbdff;
  }

  #live :global(.mat) {
    min-height: 26rem;
  }

  /* Also in the sidebar */

  .more {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .more {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .more :global(svg) {
    margin-bottom: 0.75rem;
    color: var(--ink-soft);
  }

  /* Privacy */

  .privacy {
    display: grid;
    gap: 3rem 4rem;
  }

  @media (min-width: 64rem) {
    .privacy {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
    }
  }

  .privacy .lead {
    margin-top: 1.25rem;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.75rem;
    font-weight: 500;
  }

  .ledger {
    border-top: 1px solid var(--line-strong);
  }

  .ledger div {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 40rem) {
    .ledger div {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }

  .ledger dt {
    color: var(--ink-faint);
    font-size: 0.9375rem;
  }

  .ledger dd {
    font-size: 0.9375rem;
  }

  /* Open source */

  .closing {
    display: grid;
    gap: 2rem 4rem;
    align-items: end;
  }

  .closing .lead {
    margin-top: 1rem;
  }

  @media (min-width: 64rem) {
    .closing {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>

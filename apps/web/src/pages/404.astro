---
import Page from "../layouts/Page.astro"
import { PATHS } from "../routes.ts"
---

<Page
  title="Page not found – Katip"
  description="There is no page at this address."
  path="/404/"
  indexable={false}
>
  <div class="not-found container">
    <p class="code mono">404</p>
    <h1>This tab leads nowhere</h1>
    <p class="text">The page you were looking for isn’t here, or has moved.</p>
    <a class="home" href={PATHS.home}>
      Go to the Katip home page
    </a>
  </div>
</Page>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    padding-top: clamp(6rem, 4rem + 8vw, 10rem);
    text-align: center;
  }

  .code {
    color: var(--ink-faint);
    font-size: 0.875rem;
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2.5rem, 1.75rem + 3vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .text {
    margin-top: 1.25rem;
    color: var(--ink-soft);
    font-size: 1.125rem;
  }

  .home {
    margin-top: 2rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.625rem;
    background: var(--accent);
    color: #fff;
    font-weight: 500;
  }

  .home:hover {
    background: var(--accent-hover);
    text-decoration: none;
  }
</style>

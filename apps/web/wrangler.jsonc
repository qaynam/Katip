{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "katip-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Attached on deploy; qaynam.dev must be a zone in the same Cloudflare account. Keep it equal to
  // SITE_URL in src/site.ts
  "routes": [{ "pattern": "katip.qaynam.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the root needs a decision; every other path is a file in dist/ and skips the Worker
    "run_worker_first": ["/"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}

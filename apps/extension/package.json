{
  "name": "@katip/extension",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#modules/*": "./src/modules/*/index.ts",
    "#platform/*": "./src/platform/*/index.ts",
    "#protocol": "./src/protocol/index.ts"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "package": "node scripts/package-extension.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint ."
  },
  "dependencies": {
    "@phosphor-icons/core": "2.1.1",
    "effect": "4.1.0",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "@types/opentype.js": "1.3.10",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "opentype.js": "2.0.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

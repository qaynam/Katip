{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "outputs": ["dist/**"] },
    "package": { "cache": false, "outputs": [".release/**"] },
    "preview": { "cache": false, "persistent": true, "dependsOn": ["build"] },
    "deploy": {
      "cache": false,
      "dependsOn": ["build"],
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "WRANGLER_SEND_METRICS"]
    },
    "typecheck": {},
    "lint": {},
    "test": {},
    "test:e2e": { "cache": false, "passThroughEnv": ["KATIP_E2E_CHROME"] }
  }
}
